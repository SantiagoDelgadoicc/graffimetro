# Copia este archivo como .env.local y rellena las claves. .env.local nunca se sube a Git.

# Groq (IA principal) — https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (IA de respaldo) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Postgres local en Docker (docker-compose.yml)
DATABASE_URL=postgres://lapuja:lapuja@127.0.0.1:5432/lapuja
